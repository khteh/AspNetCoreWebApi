<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
	  <LangVersion>15.0</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiGenerationEnvironment>Development</OpenApiGenerationEnvironment>
  </PropertyGroup>  
  <!-- LibMan cache root = Environment.SpecialFolder.LocalApplicationData/.librarymanager/cache -->
  <PropertyGroup>
    <LibManCacheRoot Condition="'$(OS)' == 'Windows_NT'">$(LOCALAPPDATA)\.librarymanager\cache</LibManCacheRoot>
    <LibManCacheRoot Condition="'$(OS)' != 'Windows_NT' And '$(XDG_DATA_HOME)' != ''">$(XDG_DATA_HOME)/.librarymanager/cache</LibManCacheRoot>
    <LibManCacheRoot Condition="'$(OS)' != 'Windows_NT' And '$(XDG_DATA_HOME)' == ''">$(HOME)/.local/share/.librarymanager/cache</LibManCacheRoot>
    <!-- Refresh @latest libraries on Release builds; override with -p:RefreshLibMan=true|false -->
    <RefreshLibMan Condition="'$(RefreshLibMan)' == '' And '$(Configuration)' == 'Release'">true</RefreshLibMan>
  </PropertyGroup>

  <Target Name="CleanLibManCache"
          BeforeTargets="LibraryManagerRestore"
          Condition="'$(RefreshLibMan)' == 'true'">
    <!-- Equivalent of `libman cache clean unpkg` -->
    <RemoveDir Directories="$(LibManCacheRoot)/unpkg" />
    <Message Importance="high" Text="Cleared LibMan unpkg cache: $(LibManCacheRoot)/unpkg" />
  </Target>    
  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageReference Include="AutoMapper" Version="17.0.0" />
    <PackageReference Include="Elastic.Apm.NetCoreAll" Version="1.36.0" />
    <PackageReference Include="Elastic.CommonSchema.Serilog" Version="9.0.0" />
    <PackageReference Include="Elastic.Serilog.Sinks" Version="9.0.0" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.85.0" />
    <PackageReference Include="Grpc.AspNetCore.Web" Version="2.85.0" />
    <PackageReference Include="MediatR" Version="15.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.3" />
    <PackageReference Include="Microsoft.Web.LibraryManager.Build" Version="3.0.114" />
    <PackageReference Include="Serilog.Enrichers.HttpContext" Version="8.3.0" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Exceptions" Version="8.4.0" />
    <PackageReference Include="Serilog.Expressions" Version="5.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="11.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Settings.AppSettings" Version="3.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="11.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="11.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="11.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="11.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Web.Api.Core\Web.Api.Core.csproj" />
    <ProjectReference Include="..\Web.Api.Infrastructure\Web.Api.Infrastructure.csproj" />
    <None Include="appsettings.json" CopyToOutputDirectory="Always" />
    <None Include="appsettings.Development.json" CopyToOutputDirectory="Always" />
    <None Include="appsettings.IntegrationTests.json" CopyToOutputDirectory="Always" />
  </ItemGroup>
</Project>